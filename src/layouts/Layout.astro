---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollUpButton from '../components/ScrollUpButton.astro';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const { title, description, canonicalURL, noindex } = Astro.props;
const resolvedCanonicalURL =
  canonicalURL ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<html lang="en">
  <head>
    <script is:inline>
      // Flash-of-wrong-color-mode prevention: must run before first paint.
      // If nothing is stored, do nothing — the CSS prefers-color-scheme
      // fallback in tokens.css already handles that case correctly.
      const storedColorMode = localStorage.getItem('color-mode');
      if (storedColorMode) {
        document.documentElement.setAttribute(
          'data-color-mode',
          storedColorMode,
        );
      }
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={resolvedCanonicalURL} />
      )
    }
    <title>{title}</title>
    <Font cssVariable="--font-ibm-plex-sans" preload />
  </head>
  <body>
    <Header />
    <div class="page-content">
      <slot />
    </div>
    <Footer />
    <ScrollUpButton />
  </body>
</html>

<style>
  .page-content {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding: var(--space-lg);
    padding-block-start: var(--space-2xl);
  }

  @media (width <= 640px) {
    .page-content {
      padding-block-start: var(--space-md);
    }
  }
</style>
