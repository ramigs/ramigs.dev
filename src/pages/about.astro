---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Merchant Payments Platform',
    description:
      'Owned the frontend for a payments platform used by merchants across many countries to offer multiple payment methods to their own customers — card payments, Apple Pay, Google Pay, Pix, Boleto, Trustly, and Volt — with per-merchant control over which methods to expose. The core challenge was unifying fundamentally different integration models (redirect-based regional methods, card flows, wallet APIs) behind one consistent, embeddable interface.',
  },
  {
    name: 'White-Label Bitcoin Exchange Platform',
    description:
      'Owned the frontend for the end-customer application of a white-label Bitcoin exchange platform — user authentication (email and e-ID), compliance onboarding, and buying, selling, and transferring Bitcoin — sold and customized across up to four brands from one shared codebase. The core challenge was a design system and feature-toggle architecture flexible enough for real per-brand differences, built and maintained under the strict compliance requirements of a regulated financial product.',
  },
  {
    name: 'Card Payments SDK',
    description:
      'Designed and built a framework-agnostic TypeScript SDK abstracting card tokenization and 3D Secure behind a single interface, used as the underlying card-payments engine for consumer-facing frontend applications — supporting multiple tokenization and 3DS providers (PCI-Proxy, Evervault, Paysafe) interchangeably. The core challenge was normalizing genuinely different provider request/response shapes and 3DS challenge/redirect flows so consumer apps never needed to know which provider was active underneath.',
  },
];

const toolsAndTech = [
  { category: 'Frontend', items: ['Vue.js', 'Nuxt.js', 'Astro'] },
  { category: 'Backend', items: ['Node.js', 'AWS Lambda'] },
  { category: 'Languages', items: ['TypeScript', 'JavaScript'] },
  { category: 'Build & Deploy', items: ['Docker', 'GitHub Actions'] },
  { category: 'AI Tools', items: ['Claude Code', 'GitHub Copilot'] },
];
---

<Layout
  title="About | ramigs.dev"
  description="Rami Shashati — frontend engineer specializing in Vue, Nuxt, and TypeScript, with a focus on fintech payments."
>
  <section class="intro">
    <h1>About</h1>
    <p>
      I'm a frontend engineer with a decade of experience building for the web,
      currently focused on Vue, Nuxt, and TypeScript. Over the past several
      years I've specialized in fintech payments — designing and shipping
      secure, PCI-compliant checkout flows across a range of payment providers
      and methods.
    </p>
    <p>
      The problems I find most interesting live where user experience and
      compliance pull in different directions — keeping a flow simple without
      cutting corners on security and regulation requirements.
    </p>
  </section>

  <section class="projects">
    <h2>Recent Projects</h2>
    <ul role="list">
      {
        projects.map((project) => (
          <li>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="tools">
    <h2>Tools &amp; Tech</h2>
    <ul role="list">
      {
        toolsAndTech.map(({ category, items }) => (
          <li>
            <strong>{category}:</strong> {items.join(', ')}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="contact">
    <h2>Contact</h2>
    <p>
      Have something in mind — a role, a project, or just want to talk shop?
      Feel free to <a href="mailto:ramigs@gmail.com">get in touch</a>.
    </p>
  </section>
</Layout>

<style>
  section:not(:first-child) {
    margin-block-start: var(--space-2xl);
  }

  section h2 {
    padding-block-end: var(--space-sm);
    border-block-end: 1px solid var(--color-border);
  }

  .intro p {
    margin-block-start: var(--space-md);
  }

  .projects ul,
  .tools ul {
    padding-inline-start: 0;
    margin-block-start: var(--space-md);
  }

  .projects li:not(:first-child) {
    margin-block-start: var(--space-lg);
  }

  .projects h3 {
    font-size: var(--font-size-h4);
  }

  .projects p {
    margin-block-start: var(--space-xs);
    color: var(--color-text-muted);
  }

  .tools li:not(:first-child) {
    margin-block-start: var(--space-sm);
  }

  .contact p {
    margin-block-start: var(--space-md);
  }
</style>
