---
import { Font } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ClockIcon from '../../assets/icons/tabler/clock.svg';

const WORDS_PER_MINUTE = 200;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, date, tags, canonical } = post.data;
const { Content } = await render(post);

// The `til` tag is redundant to display — every such post already says
// "[TIL] ..." in its own title.
const visibleTags = tags.filter((tag) => tag !== 'til');

const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE));
---

<Layout
  title={`${title} | ramigs.dev`}
  description={description}
  canonicalURL={canonical}
  ogType="article"
  publishedTime={date}
>
  <Font cssVariable="--font-ibm-plex-mono" />
  <article class="post-content">
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={date.toISOString()}>
        {
          date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </time>
      <span class="meta-separator" aria-hidden="true">·</span>
      <span class="reading-time" title={`${wordCount} words`}>
        <ClockIcon class="icon" aria-hidden="true" />
        {readingMinutes} min read
      </span>
      {
        visibleTags.length > 0 && (
          <span class="tags">{visibleTags.join(', ')}</span>
        )
      }
    </p>
    <Content />
  </article>
</Layout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-block-end: var(--space-lg);
    padding-block-end: var(--space-sm);
    border-block-end: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .meta-separator {
    color: var(--color-border);
  }

  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .icon {
    width: 1em;
    height: 1em;
  }

  .tags {
    margin-inline-start: auto;
  }

  @media (width <= 640px) {
    .tags {
      flex-basis: 100%;
      margin-inline-start: 0;
    }
  }
</style>

<style is:global>
  .post-content p:not(:first-child) {
    margin-block-start: var(--space-md);
  }

  .post-content h2:not(:first-child) {
    margin-block-start: var(--space-2xl);
  }

  .post-content h3:not(:first-child) {
    margin-block-start: var(--space-xl);
  }

  .post-content h4:not(:first-child) {
    margin-block-start: var(--space-lg);
  }

  .post-content blockquote {
    padding-inline-start: var(--space-md);
    border-inline-start: 2px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .post-content pre {
    padding: var(--space-md);
    border-radius: var(--radius);

    /* Long lines scroll horizontally within the block rather than
       overflowing the page or wrapping mid-token — the standard approach,
       and independent of the Shiki theme/colors, which come later. */
    overflow-x: auto;
  }

  .post-content table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
  }

  .post-content th,
  .post-content td {
    padding: var(--space-xs) var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .post-content ul:not(:first-child),
  .post-content ol:not(:first-child),
  .post-content blockquote:not(:first-child),
  .post-content pre:not(:first-child),
  .post-content table:not(:first-child) {
    margin-block-start: var(--space-md);
  }

  .post-content li:not(:first-child) {
    margin-block-start: var(--space-sm);
  }

  .post-content code {
    font-family: var(--font-ibm-plex-mono);

    /* Monospace fonts read visually larger than proportional text at the
       same declared size, so scaling down keeps inline code from feeling
       oversized next to surrounding prose. */
    font-size: 0.875em;
  }

  .post-content :not(pre) > code {
    padding: 0.15em 0.35em;
    border-radius: var(--radius);
    background-color: var(--color-background-subtle);
  }
</style>
