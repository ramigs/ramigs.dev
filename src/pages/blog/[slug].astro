---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'sample-post-one' } },
    { params: { slug: 'sample-post-two' } },
  ];
}

const { slug } = Astro.params;
---

<Layout title={`${slug} | ramigs.dev`}>
  <h1>Blog post placeholder: {slug}</h1>
  <p>
    Placeholder route — real content arrives in Phase 4 (Content Collection).
  </p>
</Layout>
